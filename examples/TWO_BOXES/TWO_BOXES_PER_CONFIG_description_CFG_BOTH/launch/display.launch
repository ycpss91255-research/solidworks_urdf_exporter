<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find TWO_BOXES_PER_CONFIG_description_CFG_BOTH)/urdf/TWO_BOXES_PER_CONFIG_description_CFG_BOTH.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find TWO_BOXES_PER_CONFIG_description_CFG_BOTH)/urdf.rviz" />
</launch>